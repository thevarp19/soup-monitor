{
  "name": "soup-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:save": "NO_COLOR=1 node scripts/run-and-save.mjs results/test-output.txt -- vitest run --reporter=verbose",
    "test:e2e:save": "node scripts/run-and-save.mjs results/e2e-output.txt -- playwright test --reporter=list",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "test:mutation": "node scripts/run-and-save.mjs results/mutation-output.txt -- node scripts/mutation-check.mjs",
    "perf:verify": "node scripts/run-and-save.mjs perf/experiments/verify-assumptions.txt -- node --no-warnings perf/experiments/verify-assumptions.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
